# ─── Banco de dados ───────────────────────────────────────────────────────────
# PostgreSQL — Railway injeta automaticamente em produção.
# Em dev, use a DATABASE_PUBLIC_URL do Railway (acesso externo).
DATABASE_URL=postgresql://usuario:senha@host:porta/railway

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Segredo para assinar tokens de sessão (HMAC-SHA256). Mude em produção.
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria

# Senha do painel admin (admin.votografia.com.br)
ADMIN_PASSWORD=troque-em-producao

# ─── APIs externas ────────────────────────────────────────────────────────────
# Token Bearer da API v2 do X/Twitter. Opcional — sem ele, usa dados mock.
X_API_BEARER_TOKEN=

# ─── URL base (produção) ──────────────────────────────────────────────────────
# Usado pelo servidor para chamar as próprias APIs (ex: /api/mentions).
# Em dev não é necessário — usa http://localhost:3010 por padrão.
NEXT_PUBLIC_BASE_URL=https://vanhattem.votografia.com.br
