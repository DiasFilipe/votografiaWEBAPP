# ─── Identidade do cliente ───────────────────────────────────────────────────
CLIENTE_ID=van-hattem
CLIENTE_NOME=Van Hattem
CLIENTE_NOME_COMPLETO=Marcel van Hattem
CLIENTE_PARTIDO=Novo
CLIENTE_ESTADO=RS
CLIENTE_CARGO=Deputado Federal

# Cor primária (hex) e cor do texto sobre ela
CLIENTE_COR=#f59e0b
CLIENTE_COR_TEXTO=#000000

# Foto: coloque o arquivo em webapp/public/foto.jpg (ou personalize o path)
CLIENTE_FOTO=/foto.jpg

# ─── Módulos ativos (true/false) ────────────────────────────────────────────
# Remova ou defina como "false" para desativar um módulo no sidebar
MODULO_PAINEL=true
MODULO_SENTIMENTO=true
MODULO_MOBILIZACAO=true

# ─── Variáveis públicas (disponíveis no browser) ─────────────────────────────
NEXT_PUBLIC_CLIENTE_NOME=Van Hattem
NEXT_PUBLIC_CLIENTE_PARTIDO=Novo
NEXT_PUBLIC_CLIENTE_ESTADO=RS
NEXT_PUBLIC_CLIENTE_CARGO=Deputado Federal
NEXT_PUBLIC_CLIENTE_COR=#f59e0b
NEXT_PUBLIC_CLIENTE_COR_TEXTO=#000000
NEXT_PUBLIC_CLIENTE_FOTO=/foto.jpg
NEXT_PUBLIC_MODULO_PAINEL=true
NEXT_PUBLIC_MODULO_SENTIMENTO=true
NEXT_PUBLIC_MODULO_MOBILIZACAO=true

# ─── APIs externas ────────────────────────────────────────────────────────────
X_API_BEARER_TOKEN=
